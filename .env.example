# Arbitrade runtime environment reference.
# Copy to .env and fill in real values. Never commit a populated .env file,
# production credentials, the TOTP encryption key, or production data.

# Required in production.
DATABASE_URL=
SESSION_SECRET=
PASSWORD_PEPPER=
TOTP_ENCRYPTION_KEY=

# Runtime.
NODE_ENV=production
PORT=3000
# Number of trusted reverse-proxy hops; use 0 for direct access.
TRUST_PROXY_HOPS=0

# Optional integrations. Leave blank to disable.
AI_API_BASE_URL=
AI_API_KEY=
IMAGE_API_BASE_URL=
IMAGE_API_KEY=
TRANSCRIPTION_API_BASE_URL=
TRANSCRIPTION_API_KEY=
GOOGLE_MAPS_SERVER_KEY=
